<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="a300">
<xacro:property name="body_length" value="0.75"/><xacro:property name="body_width" value="0.62"/><xacro:property name="body_height" value="0.75"/><xacro:property name="wheel_radius" value="0.18"/><xacro:property name="wheel_width" value="0.05"/><xacro:property name="wheel_track" value="0.55"/><xacro:property name="lidar_height" value="0.70"/>
<material name="body"><color rgba="0.2 0.2 0.2 1"/></material><material name="wheel"><color rgba="0.05 0.05 0.05 1"/></material>
<link name="base_link"><visual><origin xyz="0 0 0.40"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="body"/></visual><collision><origin xyz="0 0 0.40"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision><inertial><origin xyz="0 0 0.40"/><mass value="60"/><inertia ixx="3" ixy="0" ixz="0" iyy="4" iyz="0" izz="4"/></inertial></link>
<link name="left_wheel"><visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel"/></visual><collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision></link>
<link name="right_wheel"><visual><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel"/></visual><collision><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision></link>
<joint name="left_wheel_joint" type="continuous"><parent link="base_link"/><child link="left_wheel"/><origin xyz="0 ${wheel_track/2} ${wheel_radius}" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
<joint name="right_wheel_joint" type="continuous"><parent link="base_link"/><child link="right_wheel"/><origin xyz="0 -${wheel_track/2} ${wheel_radius}" rpy="1.5708 0 0"/><axis xyz="0 0 1"/></joint>
<link name="caster"><visual><origin xyz="0 0 0.08"/><geometry><sphere radius="0.08"/></geometry></visual><collision><origin xyz="0 0 0.08"/><geometry><sphere radius="0.08"/></geometry></collision></link>
<joint name="caster_joint" type="fixed"><parent link="base_link"/><child link="caster"/><origin xyz="-0.28 0 0"/></joint>
<link name="laser_link"/><joint name="laser_joint" type="fixed"><parent link="base_link"/><child link="laser_link"/><origin xyz="0.20 0 ${lidar_height}"/></joint>
</robot>