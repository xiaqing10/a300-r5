<?xml version="1.0"?>
<sdf version="1.9">
  <world name="a300_test">
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.4 0.2 -1.0</direction></light>
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry></visual>
    </link></model>
  <model name="wall_ahead"><static>true</static><link name="link">
    <collision name="collision"><geometry><box><size>0.2 1.5 1.5</size></box></geometry></collision>
    <visual name="visual"><geometry><box><size>0.2 1.5 1.5</size></box></geometry></visual><pose>1.2 0 0.75 0 0 0</pose>
  </link></model>
  <model name="status_green"><static>true</static><link name="link">
    <visual name="visual">
      <geometry><sphere><radius>0.30</radius></sphere></geometry>
      <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
    </visual>
  </link><pose>50 50 1.0 0 0 0</pose></model>
  <model name="status_yellow"><static>true</static><link name="link">
    <visual name="visual">
      <geometry><sphere><radius>0.30</radius></sphere></geometry>
      <material><ambient>1 1 0 1</ambient><diffuse>1 1 0 1</diffuse></material>
    </visual>
  </link><pose>50 50 1.0 0 0 0</pose></model>
  <model name="status_orange"><static>true</static><link name="link">
    <visual name="visual">
      <geometry><sphere><radius>0.30</radius></sphere></geometry>
      <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
    </visual>
  </link><pose>50 50 1.0 0 0 0</pose></model>
  <model name="status_red"><static>true</static><link name="link">
    <visual name="visual">
      <geometry><sphere><radius>0.30</radius></sphere></geometry>
      <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
    </visual>
  </link><pose>50 50 1.0 0 0 0</pose></model>
</world>
</sdf>
